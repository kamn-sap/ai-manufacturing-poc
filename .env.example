PORT=3000
JWT_SECRET=replace-this-with-a-long-random-secret
AUTH_USERNAME=operator
AUTH_PASSWORD=change-me
# Optional: replace the single-user settings with a JSON array for multiple accounts.
# AUTH_USERS_JSON='[{"username":"operator","password":"change-me"},{"username":"reviewer","password":"replace-with-a-long-password"}]'
LLM_PROVIDER=mock
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=https://127.0.0.1:9297
# Set these paths to the files generated by AWS Emulator:
# AWS_SHARED_CREDENTIALS_FILE=/home/your-user/.aws/emulator/9297/emulator_credentials
# AWS_CONFIG_FILE=/home/your-user/.aws/emulator/9297/config
# AWS_CA_BUNDLE=/home/your-user/.aws/emulator/9297/ca.pem
AWS_SDK_LOAD_CONFIG=true
AWS_EC2_METADATA_DISABLED=true
AWS_DISABLE_HOST_PREFIX_INJECTION=true
S3_BUCKET=manufacturing-documents
SQLITE_PATH=.data/manufacturing.db
CORS_ORIGIN=http://localhost:5173
