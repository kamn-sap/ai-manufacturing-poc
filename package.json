{
  "name": "ai-manufacturing-poc",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"node --env-file-if-exists=.env --watch backend/src/server.js\" \"node node_modules/vite/bin/vite.js --host 0.0.0.0 --config vite.config.js frontend\"",
    "dev:api": "node --env-file-if-exists=.env --watch backend/src/server.js",
    "dev:web": "node node_modules/vite/bin/vite.js --host 0.0.0.0 --config vite.config.js frontend",
    "worker": "node --env-file-if-exists=.env backend/src/workers/ingestWorker.js",
    "aws:init": "node --env-file-if-exists=.env --import tsx scripts/init-aws-resources.ts",
    "test": "vitest run",
    "lint": "eslint backend/src frontend/src scripts e2e --max-warnings=0",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3.1175.0",
    "@aws-sdk/client-s3": "^3.1175.0",
    "@aws-sdk/client-sqs": "^3.1175.0",
    "@playwright/test": "^1.65.1",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "dotenv": "^18.0.10",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
